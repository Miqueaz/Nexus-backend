{
  "name": "nexo-backend",
  "version": "1.0.0",
  "description": "API modular de negocios con MongoDB, Bearer JWT y auditor\u00eda transaccional",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.js",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(64).toString('base64url'))\"",
    "setup": "node scripts/setup.js",
    "format": "prettier --write src test scripts docs/frontend-adapter.js",
    "format:check": "prettier --check src test scripts docs/frontend-adapter.js"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "mongodb": "7.7.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
