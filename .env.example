NODE_ENV=development
PORT=3000
# MongoDB local de compose.yaml; replica set obligatorio.
MONGO_URI=mongodb://localhost:27017/nexo?replicaSet=rs0&directConnection=true
MONGO_DB=nexo
# npm run setup genera una clave aleatoria; nunca reutilices la clave entre entornos.
JWT_SECRET=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_48_CARACTERES
JWT_ISSUER=nexo-api
JWT_AUDIENCE=nexo-app
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://nexo.aethel.ing
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Identificador público del cliente OAuth web; no requiere client secret.
GOOGLE_CLIENT_ID=259045388211-p4fk2jnqhm40t1tqa91da7ic1qbn76ak.apps.googleusercontent.com

# Administradores globales: los correos requieren identidad verificada de Google.
PLATFORM_ADMIN_EMAILS=
# Alternativa de recuperación por IDs existentes, asignada solo desde el servidor.
PLATFORM_ADMIN_USER_IDS=
