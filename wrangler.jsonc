{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexis-backend",
  "main": "src/workers/index.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "api.nexo.aethel.ing", "custom_domain": true }],
  "vars": {
    "NODE_ENV": "production",
    "API_RUNTIME": "direct",
    "MONGO_DB": "nexo",
    "MONGO_AUTO_MIGRATE": "true",
    "GOOGLE_CLIENT_ID": "259045388211-p4fk2jnqhm40t1tqa91da7ic1qbn76ak.apps.googleusercontent.com",
    "JWT_ISSUER": "nexo-api",
    "JWT_AUDIENCE": "nexo-app",
    "ACCESS_TOKEN_MINUTES": "30",
    "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://nexo-negocios-isaac.mik-chivasrayo-l.chatgpt.site,https://nexo.aethel.ing",
    "LOG_LEVEL": "info",
  },
  "durable_objects": { "bindings": [{ "name": "BUSINESS_API", "class_name": "BusinessApi" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BusinessApi"] }],
  "observability": { "enabled": true },
}
